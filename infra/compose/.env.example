APP_ENV=local
APP_VERSION=0.1.0
API_PREFIX=/api
CORS_ORIGINS=*

DB_DRIVER=postgresql+asyncpg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=bookverse
DB_PASSWORD=bookverse
DB_NAME=bookverse
DB_POOL_SIZE=5

REDIS_URL=redis://127.0.0.1:6379/0
CACHE_URL=redis://127.0.0.1:6379/1

OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_INDEX_BOOKS=bookverse_books
OPENSEARCH_INDEX_AUTHORS=bookverse_authors

S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=bookverse
S3_SECRET_KEY=bookverse
S3_BUCKET=bookverse-assets
S3_REGION=us-east-1

RATE_LIMIT_DEFAULT=60/minute

WORKER_CONCURRENCY=4

# Generate a real secret for anything beyond local dev: openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
